#!/usr/bin/env bash
#ddev-generated

## Description: Build TYPO3 (composer) and frontend (npm, pnpm or yarn) - the pipeline runs exactly the same steps
## Usage: build [be|fe] [--prod] [--frontend=<dir>] [--backend=<dir>]
## Example: "ddev build" (all), "ddev build fe" (frontend only), "ddev build --prod" (production build), "ddev build fe --frontend=frontend-shop" (another frontend), "ddev build be --backend=api" (another backend)

set -euo pipefail

target=all
prod=0
script=build
frontend=${BUILD_FRONTEND:-}
backend=.
for arg in "$@"; do
    case "$arg" in
        be|fe) target=$arg ;;
        --prod) prod=1; script=ci ;;
        --frontend=*) frontend=${arg#--frontend=} ;;
        --backend=*) backend=${arg#--backend=} ;;
        # used by "ddev serve": dev server instead of the build
        --serve) script=serve ;;
        *) echo "Unknown argument: $arg" >&2; exit 1 ;;
    esac
done

# --backend: composer project in another directory (e.g. a second backend), BUILD_LINKS (web_environment) belong to
# the project root: paths linked into public/, brace expansion allowed, e.g. "config/.htaccess frontend/build/{css,js}"
# "<path>:<name>" links <path> as public/<name> (subdirectories allowed), e.g. "frontend/build:frontend" - braces
# around the whole pair: "frontend/build/{css:assets/css,js:assets/js}"
build_be() (
    cd "$backend"
    if [ "$prod" -eq 1 ]; then
        composer install --no-interaction --no-dev --classmap-authoritative
    else
        composer install --no-interaction
    fi

    [ "$backend" = . ] || return 0
    eval "links=(${BUILD_LINKS:-})"
    for link in "${links[@]}"; do
        source=${link%%:*}
        name=$(basename "$source")
        [ "$source" = "$link" ] || name=${link#*:}
        case "$name" in
            /*|..|../*|*/..|*/../*) echo "$link: the name must stay inside public/" >&2; exit 1 ;;
        esac
        target="public/$name"
        # ln would silently create the link inside an existing directory
        if [ -d "$target" ] && [ ! -L "$target" ]; then
            echo "$target is a directory, expected a link to $source" >&2
            exit 1
        fi
        # relative link: one ../ per directory of the target (ln -r is missing in alpine images)
        mkdir -p "$(dirname "$target")"
        ln -sfn "$(dirname "$target" | sed 's|[^/]*|..|g')/$source" "$target"
    done
)

# Node.js version of a version file of the frontend (.n-node-version, .node-version, .nvmrc), otherwise the one of
# nodejs_version/nodejs_root - downloads are cached in the global ddev cache (pipeline: home directory)
# Without n (outside of the ddev image, e.g. a node image as pipeline step image) n is run by npx
node_run() {
    if [ -f .n-node-version ] || [ -f .node-version ] || [ -f .nvmrc ]; then
        local cache=$HOME/.cache n=(n)
        [ ! -w /mnt/ddev-global-cache ] || cache=/mnt/ddev-global-cache
        # path by npx from / and run by bash: npm as root runs commands as the owner of the current directory
        command -v n > /dev/null || n=(bash "$(cd / && npx --yes --package=n@10 -c 'command -v n')")
        N_CACHE_PREFIX=$cache "${n[@]}" exec --quiet --download auto "$@"
    else
        "$@"
    fi
}

# BUILD_FRONTEND (web_environment) or --frontend: frontend directory with package.json scripts "build" (dev), "ci"
# (prod) and "serve" (dev server), the package manager is chosen by the lock file
build_fe() (
    if [ -z "$frontend" ]; then
        [ "$script" != serve ] || { echo "BUILD_FRONTEND is not set in web_environment" >&2; exit 1; }
        return 0
    fi
    cd "$frontend"
    if [ -f package-lock.json ]; then
        # npm ci removes node_modules, only for the production build
        if [ "$prod" -eq 1 ]; then
            node_run npm ci
        else
            node_run npm install
        fi
        node_run npm run "$script"
    elif [ -f pnpm-lock.yaml ]; then
        # pnpm is not part of the image: version of "packageManager" in package.json, otherwise the latest
        pnpm=$(node_run node -p 'require("./package.json").packageManager?.match(/^pnpm@[^+]*/)?.[0] ?? "pnpm"')
        node_run npx --yes "$pnpm" install --frozen-lockfile
        node_run npx --yes "$pnpm" run "$script"
    else
        # libpng of packages built from source (e.g. imagemin plugins) fails to compile its NEON code on arm64,
        # the variable has to precede node_run, n exec doesn't take assignments as arguments
        CPPFLAGS="-DPNG_ARM_NEON_OPT=0" node_run yarn install --frozen-lockfile --prefer-offline
        node_run yarn "$script"
    fi
)

case "$target" in
    be) build_be ;;
    fe) build_fe ;;
    all) build_be; build_fe ;;
esac

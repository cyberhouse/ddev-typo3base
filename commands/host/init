#!/usr/bin/env bash
#ddev-generated

## Description: Initial project setup: build, fetch datasets from the NAS (VPN), import database and files
## Usage: init
## Example: "ddev init"

set -euo pipefail

ddev build

# the TYPO3 commands below differ between TYPO3 / typo3-console versions
available=$(ddev exec ./vendor/bin/typo3 list --raw)
for command in install:fixfolderstructure database:updateschema extension:setup backend:createadmin; do
    grep -q "^$command " <<< "$available" || {
        echo "TYPO3 command '$command' is missing, use a ddev-typo3base version matching this TYPO3 version" >&2
        exit 1
    }
done

mkdir -p .ddev/data
# urls: web_environment in .ddev/config.yaml
[ -f .ddev/data/typo3.sql.gz ] || ddev exec 'curl -fL --connect-timeout 10 -o .ddev/data/typo3.sql.gz "$DATASET_DATABASE_URL"'
[ -f .ddev/data/data.tar.gz ] || ddev exec 'curl -fL --connect-timeout 10 -o .ddev/data/data.tar.gz "$DATASET_FILES_URL"'
[ -f config/system/settings.php ] || printf '<?php return [];' > config/system/settings.php

# import into an empty database only (like the former mysql entrypoint)
[ "$(ddev mysql -N -e 'SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE()')" != "0" ] \
    || ddev import-db --file=.ddev/data/typo3.sql.gz
ddev exec tar -xzf .ddev/data/data.tar.gz -C public/
# bootstrap of the deployment (.mage.yml), but schema first as the dataset can be older than the code
ddev exec ./vendor/bin/typo3 install:fixfolderstructure
ddev exec ./vendor/bin/typo3 database:updateschema
ddev exec ./vendor/bin/typo3 extension:setup
# credentials: web_environment in .ddev/config.yaml, silently skipped if the user already exists
ddev exec './vendor/bin/typo3 backend:createadmin "$BACKEND_ADMIN_USERNAME" "$BACKEND_ADMIN_PASSWORD" > /dev/null 2>&1 || true'
ddev exec ./vendor/bin/typo3 cache:flush
ddev exec 'mkdir -p var/transient && printf KEEP_FILE > var/transient/ENABLE_INSTALL_TOOL'

printf "\033[32mFinished:\033[0m %s/typo3\n" "$DDEV_PRIMARY_URL"

#!/usr/bin/env bash
#ddev-generated

## Description: Initial project setup: build, fetch datasets from the NAS (VPN), import database and files
## Usage: init
## Example: "ddev init"

set -euo pipefail

# download to a temporary file first, an aborted download must not be taken for a complete dataset (urls: web_environment)
# datasets are optional: skipped if their url is not set
fetch() {
    [ ! -f ".ddev/data/$1" ] || return 0
    if ddev exec "[ -n \"\${$2:-}\" ]"; then
        ddev exec "curl -fL --connect-timeout 10 -o .ddev/data/$1.part \"\$$2\" && mv .ddev/data/$1.part .ddev/data/$1"
    else
        echo "$2 not set - $1 skipped" >&2
    fi
}

ddev build

mkdir -p .ddev/data
fetch typo3.sql.gz DATASET_DATABASE_URL
fetch data.tar.gz DATASET_FILES_URL
[ -f config/system/settings.php ] || printf '<?php return [];' > config/system/settings.php

# import into an empty database only (like the former mysql entrypoint)
if [ -f .ddev/data/typo3.sql.gz ] \
    && [ "$(ddev mysql -N -e 'SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE()')" = "0" ]; then
    ddev import-db --file=.ddev/data/typo3.sql.gz
fi
[ ! -f .ddev/data/data.tar.gz ] || ddev exec tar -xzf .ddev/data/data.tar.gz -C public/

# bootstrap of the deployment (.mage.yml) with TYPO3 core commands, typo3-console commands only if installed
# (schema first, as extension:setup needs a current be_users table and the dataset can be older than the code)
available=$(ddev exec ./vendor/bin/typo3 list --raw)
for command in install:fixfolderstructure database:updateschema; do
    if grep -q "^$command " <<< "$available"; then
        ddev exec ./vendor/bin/typo3 "$command"
    fi
done
ddev exec ./vendor/bin/typo3 extension:setup || {
    echo "extension:setup failed - a dataset older than the code needs helhum/typo3-console (database:updateschema)" >&2
    exit 1
}
# credentials: web_environment in .ddev/config.yaml, silently skipped if the user already exists
ddev exec './vendor/bin/typo3 backend:user:create -n -a -u "$BACKEND_ADMIN_USERNAME" -p "$BACKEND_ADMIN_PASSWORD" > /dev/null 2>&1 || true'
ddev exec ./vendor/bin/typo3 cache:flush
ddev exec 'mkdir -p var/transient && printf KEEP_FILE > var/transient/ENABLE_INSTALL_TOOL'

printf "\033[32mFinished:\033[0m %s/typo3\n" "$DDEV_PRIMARY_URL"

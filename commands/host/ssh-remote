#!/usr/bin/env bash
#ddev-generated

## Description: Open a bash console on a remote server of .mage.yml
## Usage: ssh-remote [environment]
## Aliases: bash-ssh
## Example: "ddev ssh-remote prod", "ddev ssh-remote pl" (unique prefix), "ddev ssh-remote" (select with arrow keys)

set -euo pipefail

# query .magephp.environments with yq of the ddev web image - no running project and no vendor/ needed
mage() {
    docker run --rm -i --entrypoint yq "$DDEV_WEBIMAGE" --yaml-fix-merge-anchor-to-spec=true \
        "explode(.) | .magephp.environments | $1" < .mage.yml
}

# arrow key menu on stderr, sets $stage
select_stage() {
    local selected=0 count=${#environments[@]} key i

    trap 'printf "\e[?25h" >&2' EXIT
    printf "Select environment (↑/↓, Enter):\n\e[?25l" >&2
    while true; do
        for ((i = 0; i < count; i++)); do
            if [ "$i" -eq "$selected" ]; then
                printf "\e[2K\e[36m> %s\e[0m\n" "${environments[$i]}" >&2
            else
                printf "\e[2K  %s\n" "${environments[$i]}" >&2
            fi
        done
        IFS= read -rsn1 key
        [ "$key" != $'\e' ] || read -rsn2 key
        case "$key" in
            '[A') selected=$(((selected - 1 + count) % count)) ;;
            '[B') selected=$(((selected + 1) % count)) ;;
            '') break ;;
        esac
        printf "\e[%dA" "$count" >&2
    done
    printf "\e[?25h" >&2
    stage=${environments[$selected]}
}

environments=()
while IFS= read -r line; do environments+=("$line"); done < <(mage 'keys | .[]')

stage=${1:-}
if [ -z "$stage" ]; then
    if [ -t 0 ]; then select_stage; else read -r stage; fi
fi

# exact name or unique prefix
matches=()
for name in "${environments[@]}"; do
    if [ "$name" = "$stage" ]; then
        matches=("$name")
        break
    fi
    case "$name" in "$stage"*) matches+=("$name") ;; esac
done
[ "${#matches[@]}" -eq 1 ] || { echo "Unknown or ambiguous environment '$stage', available: ${environments[*]}" >&2; exit 1; }

# user, host, port, ssh flags and path (one per line)
remote=()
while IFS= read -r line; do remote+=("$line"); done < <(mage '.["'"${matches[0]}"'"] | [.user, (.hosts[0] | split(":") | .[0]), (.hosts[0] | split(":") | .[1] // "22"), (.ssh.flags // ""), .host_path] | .[]')

printf "\e[1;46m ssh -t %s-p %s -l %s %s 'cd %s/current; bash --login' \e[0m\n" "${remote[3]:+${remote[3]} }" "${remote[2]}" "${remote[0]}" "${remote[1]}" "${remote[4]}" >&2
# shellcheck disable=SC2086 # ssh flags must be split
exec ssh -t ${remote[3]} -p "${remote[2]}" -l "${remote[0]}" "${remote[1]}" "cd ${remote[4]}/current; bash --login"

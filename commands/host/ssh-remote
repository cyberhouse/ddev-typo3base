#!/usr/bin/env bash
#ddev-generated

## Description: Open a bash console on a remote server of .mage.yml
## Usage: ssh-remote [environment]
## Aliases: bash-ssh
## Example: "ddev ssh-remote prod", "ddev ssh-remote pl" (unique prefix), "ddev ssh-remote" (select with arrow keys, type to filter)

set -euo pipefail

# query .magephp.environments with yq of the ddev web image - no running project and no vendor/ needed
mage() {
    docker run --rm -i --entrypoint yq "$DDEV_WEBIMAGE" --yaml-fix-merge-anchor-to-spec=true \
        "explode(.) | .magephp.environments | $1" < .mage.yml
}

# arrow key menu on stderr, typing filters it (contains, case-insensitive), sets $stage
select_stage() {
    local filter='' selected=0 offset=0 drawn=0 max=10 count key i name matches=()

    trap 'printf "\e[?25h" >&2' EXIT
    printf "\e[?25l" >&2
    shopt -s nocasematch
    while true; do
        matches=()
        for name in "${environments[@]}"; do
            if [[ "$name" == *"$filter"* ]]; then matches+=("$name"); fi
        done
        count=${#matches[@]}

        # scroll window of max entries around the selected one
        [ "$selected" -lt "$count" ] || selected=0
        [ "$selected" -ge "$offset" ] || offset=$selected
        [ "$selected" -lt $((offset + max)) ] || offset=$((selected - max + 1))

        [ "$drawn" -eq 0 ] || printf "\e[%dA" "$drawn" >&2
        printf "\e[JSelect environment (type to filter, ↑/↓, Enter): %s\n" "$filter" >&2
        drawn=1
        for ((i = offset; i < count && i < offset + max; i++)); do
            if [ "$i" -eq "$selected" ]; then
                printf "\e[36m> %s\e[0m\n" "${matches[$i]}" >&2
            else
                printf "  %s\n" "${matches[$i]}" >&2
            fi
            drawn=$((drawn + 1))
        done
        if [ "$count" -gt "$max" ]; then
            printf "  \e[2m%d/%d\e[0m\n" "$((selected + 1))" "$count" >&2
            drawn=$((drawn + 1))
        fi

        IFS= read -rsn1 key
        [ "$key" != $'\e' ] || read -rsn2 key
        case "$key" in
            '[A') [ "$count" -eq 0 ] || selected=$(((selected - 1 + count) % count)) ;;
            '[B') [ "$count" -eq 0 ] || selected=$(((selected + 1) % count)) ;;
            '') [ "$count" -eq 0 ] || break ;;
            $'\x7f' | $'\b') filter=${filter%?} selected=0 offset=0 ;;
            [[:print:]]) filter+=$key selected=0 offset=0 ;;
        esac
    done
    shopt -u nocasematch
    printf "\e[?25h" >&2
    stage=${matches[$selected]}
}

environments=()
while IFS= read -r line; do environments+=("$line"); done < <(mage 'keys | .[]')

stage=${1:-}
if [ -z "$stage" ]; then
    if [ -t 0 ]; then select_stage; else read -r stage; fi
fi

# exact name or unique prefix
matches=()
for name in "${environments[@]}"; do
    if [ "$name" = "$stage" ]; then
        matches=("$name")
        break
    fi
    case "$name" in "$stage"*) matches+=("$name") ;; esac
done
[ "${#matches[@]}" -eq 1 ] || { echo "Unknown or ambiguous environment '$stage', available: ${environments[*]}" >&2; exit 1; }

# user, host, port, ssh flags and path (one per line)
remote=()
while IFS= read -r line; do remote+=("$line"); done < <(mage '.["'"${matches[0]}"'"] | [.user, (.hosts[0] | split(":") | .[0]), (.hosts[0] | split(":") | .[1] // "22"), (.ssh.flags // ""), .host_path] | .[]')

# ssh flags are split like the shell of magallanes does, e.g. -o "ProxyCommand ssh -W %h:%p jump" (xargs: quotes
# without expansions)
ssh_flags=()
if [ -n "${remote[3]}" ]; then
    while IFS= read -r line; do ssh_flags+=("$line"); done < <(xargs printf '%s\n' <<< "${remote[3]}")
fi

printf "\e[1;46m ssh -t %s-p %s -l %s %s 'cd %s/current; bash --login' \e[0m\n" "${remote[3]:+${remote[3]} }" "${remote[2]}" "${remote[0]}" "${remote[1]}" "${remote[4]}" >&2
exec ssh -t ${ssh_flags[@]+"${ssh_flags[@]}"} -p "${remote[2]}" -l "${remote[0]}" "${remote[1]}" "cd ${remote[4]}/current; bash --login"

#!/usr/bin/env bash
#ddev-generated

## Description: Open a bash console on a remote server of .mage.yml
## Usage: ssh-remote [environment]
## Aliases: bash-ssh
## Example: "ddev ssh-remote prod", "ddev ssh-remote" (select with arrow keys)

set -euo pipefail

# "list": environments of .mage.yml (one per line), "get <env or unique prefix>": user, host, port, ssh flags and path (one per line)
mage() {
    ddev exec php -- "$@" <<'PHP'
<?php
require 'vendor/autoload.php';
$environments = Symfony\Component\Yaml\Yaml::parseFile('.mage.yml')['magephp']['environments'] ?? [];
if ($argv[1] === 'list') {
    echo implode("\n", array_keys($environments)), "\n";
    exit;
}
$search = $argv[2] ?? '';
$matches = isset($environments[$search]) ? [$search] : array_filter(array_keys($environments), fn ($name) => str_starts_with($name, $search));
if (count($matches) === 1) {
    $environment = $environments[reset($matches)];
    [$host, $port] = array_pad(explode(':', $environment['hosts'][0]), 2, '22');
    echo implode("\n", [$environment['user'], $host, $port, $environment['ssh']['flags'] ?? '', $environment['host_path']]), "\n";
}
PHP
}

# arrow key menu on stderr, sets $stage
select_stage() {
    local environments=() selected=0 count key i
    while IFS= read -r line; do environments+=("$line"); done < <(mage list)
    count=${#environments[@]}

    trap 'printf "\e[?25h" >&2' EXIT
    printf "Select environment (↑/↓, Enter):\n\e[?25l" >&2
    while true; do
        for ((i = 0; i < count; i++)); do
            if [ "$i" -eq "$selected" ]; then
                printf "\e[2K\e[36m> %s\e[0m\n" "${environments[$i]}" >&2
            else
                printf "\e[2K  %s\n" "${environments[$i]}" >&2
            fi
        done
        IFS= read -rsn1 key
        [ "$key" != $'\e' ] || read -rsn2 key
        case "$key" in
            '[A') selected=$(((selected - 1 + count) % count)) ;;
            '[B') selected=$(((selected + 1) % count)) ;;
            '') break ;;
        esac
        printf "\e[%dA" "$count" >&2
    done
    printf "\e[?25h" >&2
    stage=${environments[$selected]}
}

stage=${1:-}
if [ -z "$stage" ]; then
    if [ -t 0 ]; then select_stage; else read -r stage; fi
fi

remote=()
while IFS= read -r line; do remote+=("$line"); done < <(mage get "$stage")
[ "${#remote[@]}" -eq 5 ] || { echo "Unknown or ambiguous environment '$stage', available: $(mage list | tr '\n' ' ')" >&2; exit 1; }

printf "\e[1;46m ssh -t %s-p %s -l %s %s 'cd %s/current; bash --login' \e[0m\n" "${remote[3]:+${remote[3]} }" "${remote[2]}" "${remote[0]}" "${remote[1]}" "${remote[4]}" >&2
# shellcheck disable=SC2086 # ssh flags must be split
exec ssh -t ${remote[3]} -p "${remote[2]}" -l "${remote[0]}" "${remote[1]}" "cd ${remote[4]}/current; bash --login"
